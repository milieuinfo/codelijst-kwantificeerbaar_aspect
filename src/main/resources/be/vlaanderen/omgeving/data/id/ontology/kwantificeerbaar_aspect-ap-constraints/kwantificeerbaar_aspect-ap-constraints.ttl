omg_ont:kwantificeerbaar_aspect-ap-constraints
    a               owl:Ontology ;
    rdfs:comment
                    "Specifieert hoe de data in de codelijst van kwantificeerbaar_aspects te encoderen in RDF (i.e. RDF termen, kardinaliteiten,...)."@en ;
    rdfs:label      "Sommatie van stoffen AP Constraints Limited"@en ;
    dct:abstract    "Het kwantificeerbaar_aspect applicatieprofiel specifieert de RDF termen (klassen en properties) en bijhorende constraints die gebruikt worden voor het beschrijven van kwantificeerbaar_aspect. Het maakt hierbij zoveel mogelijk gebruik van bestaande termen (klassen en properties) uit bestaande , skos, dbo, dbp en een minimale set van nieuwe termen gedefinieerd in het Sommatie van stoffen Vocabularium."@en ;
    dct:alternative "Sommatie van stoffen AP Shapes"@en ;
    dct:creator     omg_ag_cl:creator ;
    dct:description "Dit is de SHACL encodering van het applicatieprofiel van een kwantificeerbaar_aspect dat de eerste stap van de transformatie vanuit csv controleert."@en ;
    dct:issued      "2023-10-23"^^xsd:date ;
    dct:title       "Sommatie van stoffen AP Constraints Limited"@en ;
    xkos:belongsTo  omg_dataset:codelijst-kwantificeerbaar_aspect ;
    xhv:last        omg_voc:kwantificeerbaar_aspect-ap-constraints ;
    owl:sameAs      omg_voc:kwantificeerbaar_aspect-ap-constraints ;
    owl:versionInfo "Versie 3.0.0  maart 2024"@en .


omg_voc:kwantificeerbaar_aspect-ap-constraints
    a          owl:Ontology ;
    rdfs:label "Sommatie van stoffen AP Constraints"@en ;
    owl:sameAs omg_ont:kwantificeerbaar_aspect-ap-constraints .

omg_ag_cl:creator
    rdfs:label "Ontwikkelaar codelijst"@en ;
    schema:affiliation vl_org:OVO003751 ;
    a foaf:Person;
    foaf:firstName "Geert";
    foaf:lastName "Van Haute";
    foaf:mbox <mailto:geert.vanhaute@vlaanderen.be>.

# Node Shapes
ons:kwantificeerbaar_aspect_schema
    a                sh:NodeShape ;
    rdfs:label       "conceptschema van kwantificeerbaar_aspects"@en ;
    sh:name          "conceptschema van kwantificeerbaar_aspects"@en ;
    sh:description   "Het schema waarbinnen de kwantificeerbaar_aspects gedefinieerd zijn"@en ;
    rdfs:isDefinedBy omg_ont:kwantificeerbaar_aspect-ap-constraints, omg_voc:kwantificeerbaar_aspect-ap-constraints ;
    sh:property      omg_ps:col_cs_rdf_type, omg_ps:conceptscheme_prefLabel, omg_ps:kwantificeerbaar_aspect_schema_hasTopConcept,
                     omg_ps:kwantificeerbaar_aspect_note, omg_ps:kwantificeerbaar_aspect_notation, omg_ps:kwantificeerbaar_aspect_definition , omg_ps:schema_belongsTo;
    #sh:closed true ;
    sh:targetClass   skos:ConceptScheme .




ons:kwantificeerbaar_aspect_collection
    a                sh:NodeShape ;
    rdfs:label       "verzameling"@en ;
    sh:name          "verzameling"@en ;
    sh:description   "Verzamelingen bundelen kwantificeerbaar_aspects met gelijkaardige eigenschappen, analysemethoden of matrices waarin ze gemeten worden."@en ;
    rdfs:isDefinedBy omg_ont:kwantificeerbaar_aspect-ap-constraints, omg_voc:kwantificeerbaar_aspect-ap-constraints ;
    sh:property      omg_ps:col_cs_rdf_type, omg_ps:kwantificeerbaar_aspect_definition, omg_ps:kwantificeerbaar_aspect_note, omg_ps:kwantificeerbaar_aspect_prefLabel, omg_ps:kwantificeerbaar_aspect_collection_member,
                     omg_ps:kwantificeerbaar_aspect_notation, omg_ps:kwantificeerbaar_aspect_inScheme ;
    #sh:closed true ;
    sh:targetClass   skos:Collection .

