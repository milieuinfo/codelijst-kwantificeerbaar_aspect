    a                sh:PropertyShape ;
    rdfs:label       "zie ook"@en ;
    sh:name          "zie ook"@en ;
    sh:description   "Een verwijzing naar een gelijkaardige 'resource' of een document over het onderwerp."@en ;
    rdfs:isDefinedBy omg_ont:kwantificeerbaar_aspect-ap-constraints, omg_voc:kwantificeerbaar_aspect-ap-constraints ;
