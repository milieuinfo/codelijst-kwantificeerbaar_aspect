ons:kwantificeerbaar_aspect
    a                sh:NodeShape ;
    rdfs:label       "kwantificeerbaar_aspect"@en ;
    sh:name          "kwantificeerbaar_aspect"@en ;
    sh:description   ""@en ;
    rdfs:comment     "De uniciteit van een kwantificeerbaar_aspect wordt bepaald door haar uri en notatie."@en ;
    rdfs:isDefinedBy omg_ont:kwantificeerbaar_aspect-ap-constraints, omg_voc:kwantificeerbaar_aspect-ap-constraints ;
    sh:property      omg_ps:kwantificeerbaar_aspect_rdf_type, omg_ps:kwantificeerbaar_aspect_seeAlso,
                     omg_ps:kwantificeerbaar_aspect_notation,  omg_ps:kwantificeerbaar_aspect_exactMatch, omg_ps:kwantificeerbaar_aspect_closeMatch, omg_ps:kwantificeerbaar_aspect_inScheme,
                     omg_ps:kwantificeerbaar_aspect_comment, omg_ps:kwantificeerbaar_aspect_note, omg_ps:kwantificeerbaar_aspect_definition,
                     omg_ps:kwantificeerbaar_aspect_altLabel,  omg_ps:kwantificeerbaar_aspect_prefLabel, omg_ps:kwantificeerbaar_aspect_narrowMatch,
                     omg_ps:kwantificeerbaar_aspect_theme, omg_ps:kwantificeerbaar_aspect_topConceptOf, omg_ps:kwantificeerbaar_aspect_broader,
                     omg_ps:kwantificeerbaar_aspect_narrower, omg_ps:kwantificeerbaar_aspect_narrowerTransitive, omg_ps:kwantificeerbaar_aspect_mappingRelation, omg_ps:kwantificeerbaar_aspect_broadMatch, omg_ps:kwantificeerbaar_aspect_semanticRelation, omg_ps:kwantificeerbaar_aspect_broaderTransitive;
    #sh:closed true ;
        #sh:targetSubjectsOf dcat:theme .
    sh:targetClass   skos:Concept .






omg_ps:kwantificeerbaar_aspect_broadMatch
    a                sh:PropertyShape ;
    rdfs:label       "breder concept in een ander schema"@en ;
    sh:name          "breder concept in een ander schema"@en ;
    sh:description   "De relatie tussen een concept en een breder, minder specifiek concept binnen een ander schema."@en ;
    rdfs:isDefinedBy omg_ont:kwantificeerbaar_aspect-ap-constraints, omg_voc:kwantificeerbaar_aspect-ap-constraints ;
    sh:nodeKind      sh:IRI ;
    sh:path          skos:broadMatch; .

